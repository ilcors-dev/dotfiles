term = xterm-256color

theme = light:circadia-light,dark:circadia-dark

font-family = "Ioskeley Mono"
font-size = 14
font-thicken = true
font-feature = zero
font-feature = -calt
font-feature = -liga
font-feature = -dlig

adjust-cursor-thickness = 4
shell-integration-features = no-cursor

window-inherit-font-size = false

# The window height is rarely a whole number of cells; split the leftover
# between top and bottom and paint it with the nearest row's background so
# Neovim's statusline doesn't float above a bare strip.
window-padding-balance = true
window-padding-color = extend

custom-shader = shaders/cursor_warp.glsl
cursor-color = #FD022D

background-opacity = 0.9
macos-option-as-alt = true
